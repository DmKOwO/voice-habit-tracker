<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Канал GitHub Releases: установка скачанного APK через системный инсталлер.
         На Android 8+ пользователь однократно разрешает «установку из неизвестных
         источников» в системном диалоге — тихой установки нет. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- F11 Health Connect: шаги и сон (runtime-подтверждение в самом Health Connect). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <application
        android:name=".VoiceHabitApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_duro_asterisk"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_duro_asterisk"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceHabitTracker.Splash"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VoiceHabitTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- H1: «поделиться текстом» и «выделить → Duro» ведут в тот же разбор,
                 что и голос: выжимка длинного текста из любого приложения. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Voice Recording Overlay Activity triggered by Home Screen Widget -->
        <activity
            android:name=".widget.QuickRecordActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Duro Habit Card Configure Activity (Frame 22) -->
        <activity
            android:name=".widget.DuroWidgetConfigureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Duro Single Habit Card Widget Provider (Frames 24-27) -->
        <receiver
            android:name=".widget.DuroHabitCardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duro_habit_card_widget_info" />
        </receiver>

        <!-- Duro Habits Widget Provider -->
        <receiver
            android:name=".widget.DuroHabitWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duro_habit_widget_info" />
        </receiver>

        <!-- Quick Voice Widget Provider -->
        <receiver
            android:name=".widget.QuickVoiceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_voice_widget_info" />
        </receiver>

        <!-- Habit Widget Click Receiver -->
        <receiver
            android:name=".widget.HabitWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voicehabit.tracker.ACTION_TOGGLE_HABIT" />
            </intent-filter>
        </receiver>

        <!-- F9: кнопки уведомлений-напоминаний (Готово / +10 мин). -->
        <receiver
            android:name=".worker.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voicehabit.tracker.REMINDER_DONE" />
                <action android:name="com.voicehabit.tracker.REMINDER_SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- Перепланирование напоминаний после перезагрузки. -->
        <receiver
            android:name=".worker.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- G29: обновление виджетов при смене даты/пояса. -->
        <receiver
            android:name=".worker.DateChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider для передачи скачанного APK системному установщику.
             Каталог filesDir/updates недоступен другим приложениям напрямую,
             поэтому отдаём файл через content:// URI с разовым грантом чтения. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
