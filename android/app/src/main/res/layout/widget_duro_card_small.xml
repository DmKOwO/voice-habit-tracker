<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duro_squircle"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Category on left, Mic + Check on right -->
    <LinearLayout
        android:id="@+id/card_small_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_small_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="HABIT"
            android:textColor="#A8A5A0"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Quick Mic button -->
        <FrameLayout
            android:id="@+id/btn_small_mic"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_mic_btn">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_minimal" />
        </FrameLayout>

        <!-- 1-Tap Check button -->
        <ImageView
            android:id="@+id/btn_small_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Check Habit"
            android:src="@drawable/ic_widget_circle_empty" />
    </LinearLayout>

    <!-- Habit Title -->
    <TextView
        android:id="@+id/tv_small_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Make Bed"
        android:textColor="#F4F1EA"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Center Content: Spark Streak, Grid, or Circle -->
    <FrameLayout
        android:id="@+id/layout_small_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <!-- Spark with Streak Count -->
        <LinearLayout
            android:id="@+id/layout_small_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_achievements_spark" />

            <TextView
                android:id="@+id/tv_small_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="13 Streaks"
                android:textColor="#F4F1EA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mini 4x7 Grid Bitmap -->
        <ImageView
            android:id="@+id/iv_small_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Checkmark Circle -->
        <LinearLayout
            android:id="@+id/layout_small_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_small_today_circle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_circle_done" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Done"
                android:textColor="#F4F1EA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
