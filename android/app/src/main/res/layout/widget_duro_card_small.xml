<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duro_squircle"
    android:padding="12dp">

    <!-- Top Row: Category on left, Mic + Check on right -->
    <LinearLayout
        android:id="@+id/card_small_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_small_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MORNING"
            android:textColor="#E0FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Quick Mic button -->
        <FrameLayout
            android:id="@+id/btn_small_mic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_mic_btn"
            android:contentDescription="Начать голосовую запись">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>

        <!-- 1-Tap Check button -->
        <ImageView
            android:id="@+id/btn_small_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Check Habit"
            android:src="@drawable/ic_widget_circle_empty" />
    </LinearLayout>

    <!-- Habit Title -->
    <TextView
        android:id="@+id/tv_small_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_small_top_bar"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Make Bed"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Center Content: Flame, Grid, or Circle -->
    <FrameLayout
        android:id="@+id/layout_small_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/tv_small_title"
        android:layout_marginTop="4dp">

        <!-- Flame with Streak Count -->
        <LinearLayout
            android:id="@+id/layout_small_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_flame" />

            <TextView
                android:id="@+id/tv_small_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="13 Streaks"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mini 4x7 Grid Bitmap -->
        <ImageView
            android:id="@+id/iv_small_grid"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Checkmark Circle -->
        <LinearLayout
            android:id="@+id/layout_small_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_small_today_circle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_widget_circle_done" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Today"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
