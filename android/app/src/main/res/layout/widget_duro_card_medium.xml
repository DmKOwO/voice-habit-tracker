<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duro_squircle"
    android:padding="14dp">

    <!-- Top Row: Category on left, Mic + Check on right -->
    <LinearLayout
        android:id="@+id/card_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_card_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FITNESS"
            android:textColor="#E0FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Quick Mic button to start recording freeform speech immediately -->
        <FrameLayout
            android:id="@+id/btn_card_mic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_mic_btn"
            android:contentDescription="Начать голосовую запись">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>

        <!-- 1-Tap Check/Complete Button -->
        <ImageView
            android:id="@+id/btn_card_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Check Habit"
            android:src="@drawable/ic_widget_circle_empty" />
    </LinearLayout>

    <!-- Habit Title (Middle) -->
    <TextView
        android:id="@+id/tv_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_top_bar"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Workout"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Bottom Container: Visualization on left, Quote / Checked badge on right -->
    <LinearLayout
        android:id="@+id/card_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/tv_card_title"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Visualization Slot 1: Heatmap Grid / Bar Graph Bitmap -->
        <ImageView
            android:id="@+id/iv_card_grid"
            android:layout_width="92dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <!-- Visualization Slot 2: Flame Streaks -->
        <LinearLayout
            android:id="@+id/layout_card_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_flame" />

            <TextView
                android:id="@+id/tv_card_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="13 Streaks"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Visualization Slot 3: Daily Check Circle -->
        <LinearLayout
            android:id="@+id/layout_card_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_card_today_circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_circle_done" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Today"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Side: Motivational Quote or Checked Status (Frames 24 & 26) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_checked_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duro_checked_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Checked! ✓"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_card_quote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="2"
                android:text="Stay\nHungry"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
