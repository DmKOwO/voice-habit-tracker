<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duro_squircle"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Category on left, Mic + Check on right -->
    <LinearLayout
        android:id="@+id/card_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_card_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="HABIT"
            android:textColor="#A8A5A0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Quick Mic button -->
        <FrameLayout
            android:id="@+id/btn_card_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_mic_btn">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_minimal" />
        </FrameLayout>

        <!-- 1-Tap Check/Complete Button -->
        <ImageView
            android:id="@+id/btn_card_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Check Habit"
            android:src="@drawable/ic_widget_circle_empty" />
    </LinearLayout>

    <!-- Habit Title -->
    <TextView
        android:id="@+id/tv_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Workout"
        android:textColor="#F4F1EA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Center/Bottom Visualization -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/iv_card_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/layout_card_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_achievements_spark" />

            <TextView
                android:id="@+id/tv_card_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="13 Streaks"
                android:textColor="#F4F1EA"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_card_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_card_today_circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_circle_done" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Completed"
                android:textColor="#F4F1EA"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hidden compatibility placeholders -->
    <TextView
        android:id="@+id/tv_card_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_card_checked_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
