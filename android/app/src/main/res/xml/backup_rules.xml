<?xml version="1.0" encoding="utf-8"?>
<!--
    Бэкап для Android 11 и ниже (allowBackup="false" в манифесте уже отключает
    бэкап, но явное исключение закрывает путь и на устройствах с принудительным
    бэкапом, и при отладке).
-->
<full-backup-content>
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>
