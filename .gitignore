# Keystore для подписи релизов: пользовательский keystore.jks игнорируется,
# а постоянный ключ проекта сохраняется, чтобы подписи всегда совпадали.
*.jks
*.keystore
!android/app/keystore/release.jks

# Android / Gradle
.gradle/
build/
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
local.properties
# APK не храним в git: они публикуются в GitHub Releases через CI.
*.apk
*.sha256

# IDE
.idea/
*.iml
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/

